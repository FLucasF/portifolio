---
interface Props {
  id: string;
  heading: string;
  lede?: string;
  note?: string;
  band?: boolean;
}

const { id, heading, lede, note, band = false } = Astro.props;
---

<section id={id} class:list={["section", band && "section-band"]}>
  <div class="shell">
    <header class="section-head settle">
      <div class="section-rule head-line">
        <h2 class="display section-title">{heading}</h2>
        {note && <p class="tag section-note">{note}</p>}
      </div>
      {lede && <p class="section-lede prose-measure">{lede}</p>}
    </header>

    <div class="section-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: 4.5rem;
  }

  .section-band {
    background: var(--paper-2);
  }

  .section-head {
    margin-bottom: 2.75rem;
  }

  .head-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .section-title {
    margin: 0;
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 800;
  }

  .section-note {
    margin: 0;
    color: var(--muted);
  }

  .section-lede {
    margin: 1rem 0 0;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .section {
      padding-block: 6rem;
    }
  }
</style>
