---
/**
 * Galeria de telas de um projeto, numa camada por cima da página.
 *
 * Fica em <dialog> nativo de propósito: ele já traz prisão de foco, fechar
 * no Escape e fundo inerte. Refazer isso com div é onde esse componente
 * costuma virar armadilha de acessibilidade.
 *
 * O gatilho é um link de verdade para a primeira imagem. O script o promove
 * a galeria; sem script, a pessoa ainda abre a tela. E, como um <dialog>
 * fechado não é renderizado, nenhuma imagem é baixada antes do clique.
 *
 * As capturas vêm da pasta src/assets/screens/<slug>/, na ordem do nome do
 * arquivo. Projeto sem imagem na pasta não mostra botão nenhum.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { type Bi, type Lang } from "../data/site";
import { ui } from "../i18n/ui";

interface Props {
  slug: string;
  title: string;
  captions?: Record<string, Bi>;
  lang: Lang;
}

const { slug, title, captions = {}, lang } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screens/*/*.{png,jpg,jpeg,webp,PNG,JPG,JPEG,WEBP}",
  { eager: true },
);

const folder = `../assets/screens/${slug}/`;

const slides = Object.entries(files)
  .filter(([path]) => path.startsWith(folder))
  .map(([path, mod]) => ({ name: path.slice(folder.length), img: mod.default }))
  .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }))
  .map((q) => ({ ...q, caption: captions[q.name]?.[lang] }));

const id = `screens-${slug}`;
---

{slides.length > 0 && (
  <>
    <a class="tag trigger" href={slides[0].img.src} data-open-gallery={id}>
      <span>{slides.length}&nbsp;{(slides.length === 1 ? ui.gallery.screen : ui.gallery.screens)[lang]}</span>
      <svg class="eye" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M2 10s3-5.5 8-5.5S18 10 18 10s-3 5.5-8 5.5S2 10 2 10z" />
        <circle cx="10" cy="10" r="2.25" />
      </svg>
    </a>

    <dialog class="gallery" id={id} aria-label={ui.gallery.title[lang]}>
      <div class="panel">
        <header class="top">
          <p class="tag counter" data-counter>1 / {slides.length}</p>
          <button type="button" class="button" data-close>
            <span class="sr-only">{ui.gallery.close[lang]}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
          </button>
        </header>

        <div class="stage">
          {slides.map((q, i) => (
            <figure class="slide" data-slide hidden={i > 0}>
              <Image
                class="screen"
                style={`--w: ${q.img.width}; --h: ${q.img.height}`}
                src={q.img}
                alt={q.caption ?? `${title}, ${ui.gallery.screen[lang]} ${i + 1} ${ui.gallery.of[lang]} ${slides.length}`}
                widths={[640, 1024, 1440]}
                sizes="(min-width: 1100px) 64rem, 94vw"
                format="webp"
                quality={82}
                loading="lazy"
              />
              {q.caption && <figcaption class="meta-line caption">{q.caption}</figcaption>}
            </figure>
          ))}
        </div>

      </div>

      {slides.length > 1 && (
        <nav class="arrows" aria-label={ui.gallery.title[lang]}>
          <button type="button" class="button arrow arrow-prev" data-prev>
            <span class="sr-only">{ui.gallery.previous[lang]}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4L6.5 10l6 6" /></svg>
          </button>
          <button type="button" class="button arrow arrow-next" data-next>
            <span class="sr-only">{ui.gallery.next[lang]}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4l6 6-6 6" /></svg>
          </button>
        </nav>
      )}
    </dialog>
  </>
)}

<style>
  .trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid currentColor;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  .trigger:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .eye {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gallery {
    margin: auto;
    width: min(64rem, 90vw);
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    overflow: visible;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      display 0.18s allow-discrete,
      overlay 0.18s allow-discrete;
  }

  .gallery[open] {
    opacity: 1;
    transform: none;
  }

  .gallery::backdrop {
    background: rgb(10 8 6 / 0);
    transition:
      background-color 0.18s ease,
      display 0.18s allow-discrete,
      overlay 0.18s allow-discrete;
  }

  .gallery[open]::backdrop {
    background: rgb(10 8 6 / 0.72);
  }

  /* Ponto de partida da entrada. Navegador sem @starting-style só abre direto. */
  @starting-style {
    .gallery[open] {
      opacity: 0;
      transform: translateY(0.5rem);
    }

    .gallery[open]::backdrop {
      background: rgb(10 8 6 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery,
    .gallery::backdrop {
      transition: none;
    }

    .gallery {
      transform: none;
    }
  }

  .panel {
    display: flex;
    flex-direction: column;
    max-height: 92vh;
    border: 2px solid var(--ink);
    background: var(--paper);
    overflow: hidden;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border-bottom: 1px solid var(--rule);
    flex: none;
  }

  .counter {
    margin: 0;
    color: var(--muted);
  }

  .stage {
    overflow-y: auto;
    padding: 1.25rem;
  }

  .slide {
    margin: 0;
  }

  .slide[hidden] {
    display: none;
  }

  /* Cada captura cabe no limite sem esticar até a largura. Uma tela de celular
     é retrato e uma de desktop é paisagem: forçar largura igual deixaria a do
     celular como um filete entre duas tarjas. A conta usa a proporção do
     arquivo, não a imagem carregada, então o painel já abre no tamanho final
     em vez de crescer quando ela chega. */
  .screen {
    display: block;
    width: min(100%, calc(64vh * var(--w) / var(--h)), calc(var(--w) * 1px));
    height: auto;
    aspect-ratio: var(--w) / var(--h);
    margin-inline: auto;
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .caption {
    margin-top: 0.75rem;
    text-align: center;
  }

  .button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.18s ease;
  }

  .button:hover {
    color: var(--indigo);
  }

  .button svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* As setas flanqueiam o painel em vez de ocupar um rodapé dentro dele. Em
     tela estreita não existe margem do lado de fora, então elas encostam na
     borda da imagem, com chapa de papel atrás para não sumir no desenho.
     Vem depois de .botao de propósito: mesma especificidade, ganha na ordem. */
  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    border: 1px solid var(--ink);
    color: var(--ink);
  }

  .arrow:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .arrow-prev {
    left: 0.4rem;
  }

  .arrow-next {
    right: 0.4rem;
  }

  /* Fora do painel a seta fica sobre o backdrop, que é escuro nos dois temas.
     Daí a cor de creme fixa em vez do token de papel, que inverte no escuro. */
  @media (min-width: 900px) {
    /* O painel abre mão de uma calha de 5,5rem de cada lado: é onde a seta
       pousa. Sem isso ela encosta na beira da janela e é cortada. */
    .gallery {
      width: min(64rem, calc(100vw - 11rem));
    }

    .arrow,
    .arrow:hover {
      background: none;
      border: 0;
    }

    .arrow {
      width: 3.25rem;
      height: 3.25rem;
      color: #e9e1ce;
    }

    /* Solta no backdrop, sem moldura em volta, a seta precisa de mais corpo
       para ser vista; dentro do painel o filete já dava o contorno. */
    .arrow svg {
      width: 1.75rem;
      height: 1.75rem;
    }

    .arrow:hover {
      color: #fff;
    }

    .arrow-prev {
      left: -3.75rem;
    }

    .arrow-next {
      right: -3.75rem;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  for (const trigger of document.querySelectorAll<HTMLAnchorElement>("[data-open-gallery]")) {
    const id = trigger.dataset.openGallery!;
    const dialog = document.getElementById(id) as HTMLDialogElement | null;
    if (!dialog) continue;

    const slides = [...dialog.querySelectorAll<HTMLElement>("[data-slide]")];
    const counter = dialog.querySelector<HTMLElement>("[data-counter]");
    let current = 0;

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((q, n) => (q.hidden = n !== current));
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    };

    trigger.addEventListener("click", (e) => {
      e.preventDefault(); // sem script o link abriria a imagem, que é o plano B
      show(0);
      dialog.showModal();
    });

    dialog.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-prev]")?.addEventListener("click", () => show(current - 1));
    dialog.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1));

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });

    // Clique fora do painel fecha. O <dialog> recebe o clique do próprio
    // backdrop, então basta checar se o alvo foi ele mesmo.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
