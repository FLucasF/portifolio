---
import { certificates, type Lang } from "../data/site";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Section id="certificates" heading={certificates.heading[lang]} lede={certificates.lede[lang]} band>
  <ul class="list">
    {certificates.items.map((c, i) => (
      <li class="item settle" data-settle-delay={i * 70}>
        <a class="link" href={c.url} target="_blank" rel="noopener noreferrer">
          <span class="name display">{c.title}</span>
          <span class="meta-line issuer">
            {c.issuer}{c.date && <> · {c.date[lang]}</>}
          </span>
          <span class="action tag">
            {certificates.verify[lang]} <span aria-hidden="true">↗</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Section>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .item {
    border-bottom: 1px solid var(--rule);
  }

  /* Alvo de 44px garantido pelo preenchimento da própria linha. */
  .link {
    display: grid;
    gap: 0.35rem 2rem;
    padding-block: 1.25rem;
    text-decoration: none;
    color: var(--ink);
    transition: color 0.18s ease;
  }

  .link:hover {
    color: var(--indigo);
  }

  .name {
    font-size: clamp(1.25rem, 3vw, 1.625rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .issuer {
    color: var(--muted);
  }

  .action {
    color: var(--indigo);
    align-self: center;
  }

  @media (min-width: 720px) {
    .link {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .name,
    .issuer {
      grid-column: 1;
    }

    .action {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
