---
import { stack, type Lang } from "../data/site";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Section id="ferramentas" heading={stack.heading[lang]}>
  {stack.blocks.map((bloco, b) => (
    <div class:list={["bloco", b > 0 && "bloco-secundario"]}>
      <h3 class="display bloco-titulo">{bloco.title[lang]}</h3>

      <div class="grupos">
        {bloco.groups.map((g, i) => (
          <div class="grupo settle" data-settle-delay={i * 80}>
            <h4 class="tag grupo-titulo">{g.title[lang]}</h4>
            <ul class="itens">
              {g.items.map((item) => <li class="item">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  ))}
</Section>

<style>
  .bloco + .bloco {
    margin-top: 3.5rem;
  }

  .bloco-titulo {
    margin: 0 0 1.5rem;
    padding-top: 0.75rem;
    border-top: 2px solid var(--ink);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
  }

  .grupos {
    display: grid;
    gap: 2.5rem;
  }

  .grupo-titulo {
    margin: 0 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--ink);
    color: var(--anil);
  }

  .itens {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    line-height: 1.5;
    padding-block: 0.15rem;
    border-bottom: 1px solid var(--rule);
  }

  .item:last-child {
    border-bottom: 0;
  }

  /* O segundo bloco tem a mesma estrutura e menos peso. É a diferença de
     corpo que faz a página dizer "estas eu uso" antes de "estas eu encostei",
     sem precisar de uma frase explicando. */
  .bloco-secundario .bloco-titulo {
    border-top-width: 1px;
    font-size: clamp(1.125rem, 3vw, 1.375rem);
    color: var(--muted);
  }

  .bloco-secundario .grupo-titulo {
    border-bottom-width: 1px;
    border-bottom-color: var(--rule);
  }

  .bloco-secundario .item {
    font-size: 1.0625rem;
    color: var(--muted);
  }

  @media (min-width: 720px) {
    .grupos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
    }
  }
</style>
