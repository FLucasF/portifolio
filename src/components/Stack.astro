---
import { stack, type Lang } from "../data/site";
import { toolLogos } from "../data/logos";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/* Os SVGs entram no HTML, não como <img>: só assim herdam a cor do texto. */
const svgs = import.meta.glob<string>("../assets/logos/*.svg", { query: "?raw", import: "default", eager: true });
const logoOf = (item: string) => {
  const logo = toolLogos[item];
  return logo ? { svg: svgs[`../assets/logos/${logo.file}.svg`], brand: logo.brand, file: logo.file } : null;
};
---

<Section id="tools" heading={stack.heading[lang]}>
  {stack.blocks.map((tier, b) => (
    <div class:list={["tier", b > 0 && "tier-secondary"]}>
      <h3 class="display tier-title">{tier.title[lang]}</h3>

      <div class="tool-groups">
        {tier.groups.map((g, i) => (
          <div class="tool-group settle" data-settle-delay={i * 80}>
            <h4 class="tag group-title">{g.title[lang]}</h4>
            <ul class="items">
              {g.items.map((item) => {
                const logo = logoOf(item);
                return (
                  <li class="item">
                    {/* Sem logo, o espaço fica vazio para os nomes seguirem alinhados. */}
                    <span class="logo" data-logo={logo?.file} style={logo ? `--brand: ${logo.brand}` : undefined} set:html={logo?.svg ?? ""} />
                    {item}
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>
  ))}
</Section>

<style>
  .tier + .tier {
    margin-top: 3.5rem;
  }

  .tier-title {
    margin: 0 0 1.5rem;
    padding-top: 0.75rem;
    border-top: 2px solid var(--ink);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
  }

  .tool-groups {
    display: grid;
    gap: 2.5rem;
  }

  .group-title {
    margin: 0 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--ink);
    color: var(--indigo);
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    line-height: 1.5;
    padding-block: 0.15rem;
    border-bottom: 1px solid var(--rule);
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  /* Logo na cor do texto, como o resto do folheto: duas tintas, nenhuma cor
     de marca. Fica um pouco menor que a letra, que é condensada e alta. */
  .logo {
    flex: none;
    width: 0.85em;
    height: 0.85em;
    color: inherit;
  }

  .logo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* A marca da Oracle leva o nome embaixo da cápsula e precisa de mais corpo
     para a palavra aparecer. Ela transborda a caixa do logo em vez de alargá-la:
     assim o nome da ferramenta continua alinhado com os de cima e de baixo. */
  .logo[data-logo="oracle"] :global(svg) {
    width: 1.35em;
    height: 1.35em;
    margin: -0.25em;
  }

  .item:last-child {
    border-bottom: 0;
  }

  /* O segundo bloco tem a mesma estrutura e menos peso. É a diferença de
     corpo que faz a página dizer "estas eu uso" antes de "estas eu encostei",
     sem precisar de uma frase explicando. */
  .tier-secondary .tier-title {
    border-top-width: 1px;
    font-size: clamp(1.125rem, 3vw, 1.375rem);
    color: var(--muted);
  }

  .tier-secondary .group-title {
    border-bottom-width: 1px;
    border-bottom-color: var(--rule);
  }

  .tier-secondary .item {
    font-size: 1.0625rem;
    color: var(--muted);
  }

  @media (min-width: 720px) {
    .tool-groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
    }
  }
</style>
