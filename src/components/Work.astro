---
import { work, person, type Lang } from "../data/site";
import Section from "./Section.astro";
import Galeria from "./Galeria.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Section id="projetos" heading={work.heading[lang]} lede={work.lede[lang]} band>
  <ol class="ledger">
    {work.projects.map((p, i) => (
      <li class="entry settle" data-settle-delay={i * 70}>
        <div class="entry-meta">
          <p class="tag year">{p.year}</p>
          <p class="meta-line kind">{p.kind[lang]}</p>
        </div>

        <div class="entry-main">
          <div class="entry-title-row">
            <h3 class="display entry-title">{p.title[lang]}</h3>
            <Galeria slug={p.slug} titulo={p.title[lang]} legendas={p.legendas} lang={lang} />
            {p.emCurso && (
              <span class="tag construindo">
                <span class="lampada" aria-hidden="true"></span>
                {work.building[lang]}
              </span>
            )}
            {p.download && (
              <a class="tag live" href={p.download} target="_blank" rel="noopener noreferrer">
                {work.download[lang]} <span aria-hidden="true">↓</span>
              </a>
            )}
            {p.live && (
              <a class="tag live" href={p.live} target="_blank" rel="noopener noreferrer">
                {work.live[lang]} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>

          <p class="entry-body prose-measure texto-justo">{p.body[lang]}</p>

          {p.liveNote && <p class="meta-line ressalva">{p.liveNote[lang]}</p>}

          {p.stack.length > 0 && (
            <ul class="chips">
              {p.stack.map((s) => <li class="tag chip">{s}</li>)}
            </ul>
          )}

          {p.repos.length > 0 && (
            <p class="entry-links">
              {p.repos.map((r) => (
                <a class="tag link-underline repo" href={r.url} target="_blank" rel="noopener noreferrer">
                  {r.label[lang]} ↗
                </a>
              ))}
            </p>
          )}
        </div>
      </li>
    ))}
  </ol>

  <p class="all-repos settle">
    <a class="tag link-underline" href={person.github} target="_blank" rel="noopener noreferrer">
      {work.all[lang]} ↗
    </a>
  </p>
</Section>

<style>
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
    counter-reset: none;
  }

  .entry {
    display: grid;
    gap: 1rem 2.5rem;
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .entry-meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .year {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
  }

  .kind {
    margin: 0;
  }

  .entry-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.625rem;
  }

  .entry-title {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 800;
  }

  .construindo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
  }

  .lampada {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: var(--sol);
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
    color: var(--anil);
    text-decoration: none;
    border: 1px solid currentColor;
    padding: 0.3rem 0.6rem;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  .live:hover {
    background: var(--anil);
    color: var(--paper);
  }

  .entry-body {
    margin: 0 0 1.125rem;
    color: var(--muted);
  }

  /* Ressalva do endereço no ar: avisa antes de a pessoa achar que caiu. */
  .ressalva {
    max-width: 52ch;
    margin: -0.5rem 0 1.125rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--sol);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 1.125rem;
    padding: 0;
  }

  .chip {
    border: 1px solid var(--rule);
    padding: 0.2rem 0.5rem;
    color: var(--muted);
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
  }

  /* 44px de alvo. O sublinhado fica preso ao texto, não à área de toque. */
  .repo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink);
  }

  .all-repos {
    margin: 1.5rem 0 0;
  }

  .all-repos a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  @media (min-width: 768px) {
    .entry {
      grid-template-columns: 13rem minmax(0, 1fr);
    }

    .entry-meta {
      display: block;
      padding-top: 0.6rem;
    }

    .year {
      margin-bottom: 0.35rem;
    }
  }
</style>
