---
/**
 * Estante. As capas vêm de src/assets/books, pelo `coverName` do livro, e o Astro
 * as otimiza na build — o visitante nunca fala com a Amazon.
 *
 * O glob é eager porque o nome do arquivo sai de um dado, e o <Image> precisa
 * do módulo da imagem em mãos, não de um caminho montado em tempo de execução.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { books, type Lang } from "../data/site";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const covers = import.meta.glob<{ default: ImageMetadata }>("../assets/books/*.jpg", {
  eager: true,
});

/* O texto alternativo acompanha a língua da página; antes saía sempre em
   português, inclusive em /en/. */
const describe = (title: string, author: string) =>
  lang === "pt" ? `Capa de ${title}, de ${author}` : `Cover of ${title} by ${author}`;

const shelf = books.items.map((book) => ({
  ...book,
  cover: covers[`../assets/books/${book.coverName}.jpg`]?.default,
}));
---

<Section id="books" heading={books.heading[lang]}>
  <ul class="shelf">
    {shelf.map((book, i) => (
      <li class="book settle" data-settle-delay={i * 70}>
        {book.cover ? (
          <Image
            class="cover"
            src={book.cover}
            alt={describe(book.title, book.author)}
            widths={[180, 260, 360]}
            sizes="(min-width: 720px) 11rem, 8rem"
            format="webp"
            quality={82}
            loading="lazy"
          />
        ) : (
          <div class="cover cover-empty" aria-hidden="true"></div>
        )}

        <div class="details">
          <h3 class="display title">{book.title}</h3>
          <p class="meta-line author">{book.author}</p>
        </div>
      </li>
    ))}
  </ul>
</Section>

<style>
  /* Coluna de largura fixa em vez de 1fr: é o que permite centrar a fileira.
     Com 1fr a trilha se estica e "centrar" não teria efeito nenhum. */
  .shelf {
    display: grid;
    grid-template-columns: repeat(auto-fit, 9rem);
    justify-content: center;
    gap: 2.5rem 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .book {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  /* Filete em volta da capa: numa página de tinta chapada, uma foto impressa
     ganha fio de contorno. É o que impede a capa de flutuar no papel. */
  .cover,
  .cover-empty {
    width: 100%;
    aspect-ratio: 7 / 10;
    display: block;
    border: 1px solid var(--ink);
    background: var(--paper-2);
  }

  /* "cover" preenche a caixa inteira. Era "contain", que encaixava a capa
     inteira e deixava tarja do fundo em volta — no tema escuro essa tarja é
     quase preta e aparecia como moldura.

     O corte é de uns 2% na borda, onde capa de livro só tem margem: as
     proporções reais ficam todas entre 0,62 e 0,75, perto da caixa de 0,70. */
  .cover {
    height: auto;
    object-fit: cover;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .author {
    margin: 0;
  }

  @media (min-width: 720px) {
    .shelf {
      grid-template-columns: repeat(auto-fit, 11rem);
      justify-content: start;
      gap: 3rem 2.25rem;
    }
  }
</style>
