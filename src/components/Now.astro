---
import { now, type Lang } from "../data/site";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Section id="agora" heading={now.heading[lang]} note={now.note[lang]}>
  <ul class="now-list">
    {now.items.map((item, i) => (
      <li class="now-item settle" data-settle-delay={i * 90}>
        <p class="tag now-label">{item.label[lang]}</p>
        <div class="now-text">
          <h3 class="display now-title">{item.title[lang]}</h3>
          <p class="now-body prose-measure">{item.body[lang]}</p>
        </div>
      </li>
    ))}
  </ul>
</Section>

<style>
  .now-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .now-item {
    display: grid;
    gap: 0.5rem 2.5rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .now-label {
    margin: 0;
    color: var(--anil);
    padding-top: 0.35rem;
  }

  .now-title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.375rem, 3.5vw, 1.875rem);
    font-weight: 700;
  }

  .now-body {
    margin: 0;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .now-item {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
</style>
