---
import type { Lang } from "../data/site";
import { ui } from "../i18n/ui";
import LangMenu from "./LangMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const nav = [
  { id: "sobre", label: ui.nav.about[lang] },
  { id: "agora", label: ui.nav.now[lang] },
  { id: "experiencia", label: ui.nav.experience[lang] },
  { id: "projetos", label: ui.nav.work[lang] },
  { id: "ferramentas", label: ui.nav.tools[lang] },
];
---

<header class="site-head">
  <div class="shell head-row">
    <nav class="head-nav" aria-label={ui.nav.sections[lang]}>
      {nav.map((item) => (
        <a href={`#${item.id}`} class="tag head-link">{item.label}</a>
      ))}
    </nav>

    <div class="head-tools">
      <LangMenu lang={lang} />
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .head-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.5rem;
  }

  .head-nav {
    display: none;
    gap: 1.75rem;
  }

  .head-link {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .head-link:hover {
    color: var(--anil);
  }

  /* Sem a marca à esquerda, o `auto` é o que prende os controles à direita —
     inclusive abaixo de 900px, onde o menu de seções some. */
  .head-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  @media (min-width: 900px) {
    .head-nav {
      display: flex;
    }
  }
</style>
