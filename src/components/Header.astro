---
import { person, type Lang } from "../data/site";
import { ui, otherLang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base.endsWith("/") ? base : `${base}/`;
const other = otherLang(lang);
const otherHref = other === "pt" ? root : `${root}en/`;

const nav = [
  { id: "agora", label: ui.nav.now[lang] },
  { id: "trabalhos", label: ui.nav.work[lang] },
  { id: "ferramentas", label: ui.nav.tools[lang] },
  { id: "sobre", label: ui.nav.about[lang] },
];
---

<header class="site-head">
  <div class="shell head-row">
    <a href={lang === "pt" ? root : `${root}en/`} class="mark" aria-label={person.fullName}>
      <span class="display mark-text">{person.name}</span>
    </a>

    <nav class="head-nav" aria-label={ui.nav.work[lang]}>
      {nav.map((item) => (
        <a href={`#${item.id}`} class="tag head-link">{item.label}</a>
      ))}
    </nav>

    <div class="head-tools">
      <a href={otherHref} class="tag head-link" hreflang={other}>
        {other === "en" ? "EN" : "PT"}
      </a>
      <button type="button" id="theme-toggle" class="theme-btn" aria-live="polite">
        <span class="sr-only" data-label-light={ui.theme.toLight[lang]} data-label-dark={ui.theme.toDark[lang]}>
          {ui.theme.toDark[lang]}
        </span>
        <svg viewBox="0 0 20 20" aria-hidden="true" class="theme-icon">
          <circle cx="10" cy="10" r="4.2" />
          <g class="theme-rays">
            <path d="M10 1v2.4M10 16.6V19M1 10h2.4M16.6 10H19M3.6 3.6l1.7 1.7M14.7 14.7l1.7 1.7M16.4 3.6l-1.7 1.7M5.3 14.7l-1.7 1.7" />
          </g>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");
  const label = button?.querySelector<HTMLElement>("[data-label-light]");

  function current(): "light" | "dark" {
    const set = root.getAttribute("data-theme");
    if (set === "light" || set === "dark") return set;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function sync() {
    if (!label) return;
    const isDark = current() === "dark";
    label.textContent = isDark
      ? (label.dataset.labelLight ?? "")
      : (label.dataset.labelDark ?? "");
  }

  button?.addEventListener("click", () => {
    const next = current() === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch (e) {
      /* Sem armazenamento: a escolha vale só para esta visita. */
    }
    sync();
  });

  sync();
</script>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.5rem;
  }

  .mark {
    text-decoration: none;
    color: var(--ink);
  }

  .mark-text {
    font-size: 1.5rem;
    letter-spacing: 0.01em;
  }

  .head-nav {
    display: none;
    gap: 1.75rem;
  }

  .head-link {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .head-link:hover {
    color: var(--anil);
  }

  .head-tools {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .theme-btn {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.18s ease;
  }

  .theme-btn:hover {
    color: var(--anil);
  }

  .theme-icon {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* No escuro o sol vira lua: o disco recua e os raios somem. */
  :global(:root[data-theme="dark"]) .theme-icon circle {
    fill: currentColor;
  }
  :global(:root[data-theme="dark"]) .theme-rays {
    opacity: 0.35;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-icon circle {
      fill: currentColor;
    }
    :global(:root:not([data-theme="light"])) .theme-rays {
      opacity: 0.35;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 900px) {
    .head-nav {
      display: flex;
    }
  }
</style>
