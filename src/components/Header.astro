---
import type { Lang } from "../data/site";
import { ui } from "../i18n/ui";
import LangMenu from "./LangMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const nav = [
  { id: "about", label: ui.nav.about[lang] },
  { id: "experience", label: ui.nav.experience[lang] },
  { id: "projects", label: ui.nav.work[lang] },
  { id: "tools", label: ui.nav.tools[lang] },
  { id: "certificates", label: ui.nav.certificates[lang] },
  { id: "books", label: ui.nav.books[lang] },
  { id: "contact", label: ui.nav.contact[lang] },
];
---

<header class="site-head">
  <div class="shell head-row">
    <nav class="head-nav" aria-label={ui.nav.sections[lang]}>
      {nav.map((item) => (
        <a href={`#${item.id}`} class="tag head-link">{item.label}</a>
      ))}
    </nav>

    <div class="head-tools">
      <LangMenu lang={lang} />
      <ThemeToggle lang={lang} />

      <button
        type="button"
        class="index-button"
        data-index-open
        aria-expanded="false"
        aria-controls="index"
      >
        <span class="sr-only">{ui.nav.openIndex[lang]}</span>
        <svg viewBox="0 0 20 20" aria-hidden="true" class="index-icon">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Índice de bolso: a lista de seções para quem não tem a barra larga. -->
<div class="index" id="index" hidden>
  <div class="index-top shell">
    <p class="tag index-title">{ui.nav.index[lang]}</p>
    <button type="button" class="index-button" data-index-close>
      <span class="sr-only">{ui.nav.closeIndex[lang]}</span>
      <svg viewBox="0 0 20 20" aria-hidden="true" class="index-icon">
        <path d="M5 5l10 10M15 5L5 15" />
      </svg>
    </button>
  </div>

  <nav class="index-list shell" aria-label={ui.nav.sections[lang]}>
    {nav.map((item, i) => (
      <a href={`#${item.id}`} class="index-link">
        <span class="tag index-num">{String(i + 1).padStart(2, "0")}</span>
        <span class="display index-name">{item.label}</span>
      </a>
    ))}
  </nav>
</div>

<script>
  const panel = document.getElementById("index");
  const openButton = document.querySelector<HTMLButtonElement>("[data-index-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-index-close]");

  if (panel && openButton) {
    const toggle = (open: boolean) => {
      panel.hidden = !open;
      openButton.setAttribute("aria-expanded", String(open));
      // Trava a rolagem atrás do painel, senão a página desliza por baixo.
      document.body.style.overflow = open ? "hidden" : "";
      if (open) panel.querySelector<HTMLAnchorElement>("a")?.focus();
      else openButton.focus();
    };

    openButton.addEventListener("click", () => toggle(true));
    closeButton?.addEventListener("click", () => toggle(false));

    // Escolher uma seção fecha o painel: o destino está atrás dele.
    panel.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => toggle(false)),
    );

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) toggle(false);
    });

    // Voltar à barra larga com o painel aberto o deixaria preso na tela.
    window.matchMedia("(min-width: 900px)").addEventListener("change", (e) => {
      if (e.matches && !panel.hidden) toggle(false);
    });
  }
</script>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .head-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.5rem;
  }

  .head-nav {
    display: none;
    gap: 1.5rem;
  }

  .head-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .head-link:hover {
    color: var(--indigo);
  }

  .head-tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: auto;
  }

  /* 44px de alvo, o mínimo para o polegar, sem inchar o desenho do ícone. */
  .index-button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.18s ease;
  }

  .index-button:hover {
    color: var(--indigo);
  }

  .index-icon {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .index {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    overflow-y: auto;
  }

  .index[hidden] {
    display: none;
  }

  .index-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
    flex: none;
    border-bottom: 1px solid var(--rule);
  }

  .index-title {
    margin: 0;
    color: var(--muted);
  }

  .index-list {
    padding-block: 1.5rem 3rem;
  }

  .index-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }

  .index-link:hover .index-name {
    color: var(--indigo);
  }

  /* A numeração aqui é verdadeira: é a ordem das seções na página. */
  .index-num {
    color: var(--indigo);
    flex: none;
  }

  .index-name {
    font-size: 2rem;
    font-weight: 800;
    transition: color 0.18s ease;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 900px) {
    .head-nav {
      display: flex;
    }

    .index-button[data-index-open] {
      display: none;
    }
  }
</style>
