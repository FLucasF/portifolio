---
import { experience, type Lang } from "../data/site";
import { duration, period } from "../lib/time";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/* Datas resolvidas na build: o cargo em andamento conta até hoje. */
const roles = experience.roles.map((r) => ({
  ...r,
  when: period(r.start, r.end, lang),
  duration: duration(r.start, r.end, lang),
  current: !r.end,
}));
---

<Section id="experience" heading={experience.heading[lang]}>
  <ol class="timeline">
    {roles.map((r, i) => (
      <li class="position settle" data-settle-delay={i * 70}>
        <div class="when">
          <p class="tag period">
            {r.current && <span class="lamp" aria-hidden="true"></span>}
            {r.when}
          </p>
          <p class="tag duration">{r.duration}</p>
        </div>

        <div class="details">
          <h3 class="display job-title">{r.role[lang]}</h3>
          <p class="meta-line org">
            {r.orgs.map((o, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">·</span>}
                {o.url ? (
                  <a class="company" href={o.url} target="_blank" rel="noopener noreferrer">
                    {o.name} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="company">{o.name}</span>
                )}
              </>
            ))}
            <span class="sep" aria-hidden="true">·</span> {r.mode[lang]}
            <span class="sep" aria-hidden="true">·</span> {r.place[lang]}
          </p>
          <p class="text prose-measure text-justified">{r.body[lang]}</p>
          <ul class="skills">
            {r.skills.map((s) => <li class="tag skill">{s}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</Section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .position {
    display: grid;
    gap: 0.75rem 2.5rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .when p {
    margin: 0;
  }

  /* Tracking menor para o intervalo caber numa linha só na coluna. */
  .period {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: 0.09em;
  }

  /* O mesmo marcador aceso da capa: aqui ele diz "ainda em curso". */
  .lamp {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: var(--sun);
  }

  .duration {
    margin-top: 0.3rem;
    color: var(--muted);
  }

  .job-title {
    margin: 0 0 0.4rem;
    font-size: clamp(1.375rem, 4vw, 2rem);
    font-weight: 800;
  }

  .org {
    margin: 0 0 0.9rem;
  }

  .company {
    color: var(--indigo);
    font-weight: 600;
  }

  a.company {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.18s ease;
  }

  a.company:hover {
    border-bottom-color: currentColor;
  }

  .sep {
    opacity: 0.5;
  }

  .text {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skill {
    border: 1px solid var(--rule);
    padding: 0.2rem 0.5rem;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .position {
      grid-template-columns: 15rem minmax(0, 1fr);
    }

    .when {
      padding-top: 0.55rem;
    }
  }
</style>
