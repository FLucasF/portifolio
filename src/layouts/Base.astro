---
import "../styles/global.css";
import { person, type Lang } from "../data/site";
import { ui } from "../i18n/ui";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base.endsWith("/") ? base : `${base}/`;

const title = `${person.fullName} — ${person.role[lang]}`;
const description = ui.meta.description[lang];
const canonical = new URL(lang === "pt" ? root : `${root}en/`, Astro.site);
const alternate = new URL(lang === "pt" ? `${root}en/` : root, Astro.site);
const ogImage = new URL(`${root}og.png`, Astro.site);

const fonts =
  "https://fonts.googleapis.com/css2" +
  "?family=Big+Shoulders+Display:wght@500;700;800;900" +
  "&family=JetBrains+Mono:wght@400;500;600" +
  "&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400" +
  "&display=swap";
---

<!doctype html>
<html lang={lang === "pt" ? "pt-BR" : "en"} data-theme-root>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === "pt" ? "en" : "pt-BR"} href={alternate} />
    <link rel="alternate" hreflang={lang === "pt" ? "pt-BR" : "en"} href={canonical} />
    <link rel="icon" href={`${root}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "pt" ? "pt_BR" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />

    <!-- Fixa o tema antes da primeira pintura, para não piscar branco. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") {
            root.setAttribute("data-theme", saved);
          }
        } catch (e) {
          /* localStorage bloqueado: fica no tema do sistema. */
        }
        // Libera o estado inicial da animação só com o script no ar, para que
        // uma página sem JavaScript continue legível.
        root.classList.add("js-settle");
      })();
    </script>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: person.fullName,
        alternateName: person.name,
        jobTitle: person.role[lang],
        url: canonical.toString(),
        sameAs: [person.github, person.linkedin],
        alumniOf: "Universidade Federal da Paraíba",
        address: { "@type": "PostalAddress", addressRegion: "Paraíba", addressCountry: "BR" },
      })}
    />
  </head>

  <body>
    <a href="#conteudo" class="tag skip-link">{ui.skip[lang]}</a>
    <Header lang={lang} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Assenta cada bloco quando ele entra na tela. Uma vez só, sem repetir.
      const settlers = document.querySelectorAll<HTMLElement>(".settle");
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduced || !("IntersectionObserver" in window)) {
        settlers.forEach((el) => el.classList.add("is-set"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              const delay = Number(el.dataset.settleDelay ?? 0);
              window.setTimeout(() => el.classList.add("is-set"), delay);
              observer.unobserve(el);
            }
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.05 },
        );
        settlers.forEach((el) => observer.observe(el));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -4rem;
        z-index: 70;
        padding: 0.6rem 1rem;
        background: var(--ink);
        color: var(--paper);
        transition: top 0.18s ease;
      }
      .skip-link:focus-visible {
        top: 1rem;
      }
    </style>
  </body>
</html>
